# Splunk Dev Companion — Environment Configuration

# ── Splunk Environment ──────────────────────────────────────────
# The hostname or IP of your Splunk Enterprise / Splunk Cloud instance
SPLUNK_HOST=localhost

# The management port (default 8089 for local, varies for Cloud)
SPLUNK_PORT=8089

# Splunk credentials for live execution and job polling
SPLUNK_USERNAME=admin
SPLUNK_PASSWORD=your_splunk_password

# HTTP Event Collector (HEC) token for telemetry logging (Optional)
# If left blank, telemetry logging will be gracefully skipped.
SPLUNK_HEC_TOKEN=your_hec_token

# ── AI Model Configuration ──────────────────────────────────────
# Groq API Key for the Llama 3 models (Required for Copilot, Analysis, and Generation)
GROQ_API_KEY=gsk_your_groq_api_key_here
